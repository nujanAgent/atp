<!-- What an agent reads before it connects (SPEC.md 5.2): where the tools are listed (entry), and who to ask about them.
     The addresses under example.com are placeholders; an app gives its own privacy policy and contact. -->
<atp-provider
    spec="1"
    privacyPolicy="https://example.com/privacy"
    contact="mailto:developer@example.com">
    <server id="main" mcpEras="2025-06-18" entry="com.nujan_agent.atp.sample.hello.HelloTools" />
</atp-provider>
